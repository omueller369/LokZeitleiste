# Kopiere nach .env; verwende eigene lange, zufällige Passwörter.
MYSQL_DATABASE=lokzeitleiste
MYSQL_USER=lokzeitleiste
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_TOO
# Passwort in der URL bei Sonderzeichen URL-kodieren.
DATABASE_URL=mysql+pymysql://lokzeitleiste:CHANGE_ME@db:3306/lokzeitleiste?charset=utf8mb4
PUBLIC_ORIGIN=https://example.invalid
# SMTP-Postfach mit TLS; echte Zugangsdaten nur in .env hinterlegen.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Tf-Postfächer (unabhängig vom Benachrichtigungs-SMTP). Keine echten Zugangsdaten committen.
MAILBOX_IMAP_HOST=
MAILBOX_IMAP_PORT=993
MAILBOX_SMTP_HOST=
MAILBOX_SMTP_PORT=465
MAILBOX_SMTP_SECURITY=ssl
MAILBOX_SENT_FOLDER=Sent
# Mit cryptography.fernet.Fernet.generate_key() erzeugen; sicher mit der DB sichern.
MAILBOX_ENCRYPTION_KEY=
