# Nur Beispiel. Lokal als .env.local mit eigenen Werten speichern und nicht committen.
DATABASE_URL=mysql+pymysql://lokzeitleiste:URL_ENCODED_PASSWORD@127.0.0.1:3306/lokzeitleiste?charset=utf8mb4
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false

# Tf-Postfächer (unabhängig vom Benachrichtigungs-SMTP). Keine echten Zugangsdaten committen.
MAILBOX_IMAP_HOST=
MAILBOX_IMAP_PORT=993
MAILBOX_SMTP_HOST=
MAILBOX_SMTP_PORT=465
MAILBOX_SMTP_SECURITY=ssl
MAILBOX_SENT_FOLDER=Sent
# Mit cryptography.fernet.Fernet.generate_key() erzeugen; sicher mit der DB sichern.
MAILBOX_ENCRYPTION_KEY=

# Microsoft Entra application: public client / device authorization
MAILBOX_MICROSOFT_CLIENT_ID=
MAILBOX_MICROSOFT_TENANT=common
