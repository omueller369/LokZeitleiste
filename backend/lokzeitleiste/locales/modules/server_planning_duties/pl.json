{
  "text_04b9a3e19613": "Graniczna zmiana nocna",
  "text_2f28091327c1": "Maszynista graniczny",
  "text_35d3a889824d": "Urlop",
  "text_3675898e0efe": "Służba graniczna wymaga maszynisty granicznego lub granicznego i liniowego.",
  "text_52b8ef8ce077": "Maszynista liniowy",
  "text_52e37a639da5": "Nie zaplanowano",
  "text_6c9b9f7f7346": "Graniczna zmiana dzienna",
  "text_77d64b3ca8ca": "Służba liniowa",
  "text_cf50f72af462": "Maszynista graniczny i trasowy",
  "text_d3fd46ec61ee": "Nieprawidłowa zmiana",
  "text_eb8f579b6931": "Dzień pracy"
}
