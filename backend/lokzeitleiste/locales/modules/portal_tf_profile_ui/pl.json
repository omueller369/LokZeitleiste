{
  "text_089bc2e2114b": "Kraj związkowy",
  "text_0c14ea06db17": "Adres korespondencyjny",
  "text_234440c68fad": "Anuluj usunięcie lub dodaj nowy adres korespondencyjny.",
  "text_2fc09cc0869d": "Nie znaleziono stacji macierzystej.",
  "text_30fb259129e5": "Miejscowość",
  "text_4112179c8995": "Wybierz",
  "text_49f83c924b15": "Anuluj usunięcie",
  "text_58a3778c18c4": "Ulica",
  "text_627e48128bf4": "Usuń adres",
  "text_88258f503680": "Zastąp adres korespondencyjny",
  "text_96aac63ded62": "Nie można usunąć adresu korespondencyjnego.",
  "text_baba0e46564e": "Dodaj nowy adres korespondencyjny",
  "text_c23528ca9788": "Najpierw zastąp adres korespondencyjny lub anuluj usunięcie.",
  "text_c48c100d178f": "Wymagany jest dokładnie jeden adres korespondencyjny.",
  "text_c773844fbfaf": "Miesięczny czas pracy · ",
  "text_cb964dc65391": "Kod pocztowy",
  "text_cde5bbc497af": "Wybierz stację macierzystą z wyników wyszukiwania.",
  "text_f5cff23f21bc": "Numer domu",
  "text_ff37f8ef3029": "Maksymalnie dziesięć adresów."
}
