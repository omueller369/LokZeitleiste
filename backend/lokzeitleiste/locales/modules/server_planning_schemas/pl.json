{
  "text_35d3a889824d": "Urlop",
  "text_3be14794c5b9": "Wymagane wersje wszystkich dotkniętych miesięcy",
  "text_41e669688973": "Powtórzona data",
  "text_4a71f426b3e0": "Każda data może wystąpić raz",
  "text_52e37a639da5": "Nie zaplanowano",
  "text_e79aa42d7d18": "Dzień wolny",
  "text_eb8f579b6931": "Dzień pracy"
}
