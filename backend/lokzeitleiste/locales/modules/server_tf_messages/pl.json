{
  "text_11f2410fea6e": "Nieprawidłowa nazwa pliku.",
  "text_14ae4d309870": "Sprawdź temat i wiadomość.",
  "text_181d7c8b6aa2": "Wybierz co najmniej jednego odbiorcę.",
  "text_2456bb8ed72f": "Zarządzanie pracownikami",
  "text_3587543eb803": "Pracownicy administracyjni",
  "text_35b72faaf4be": "Sprawdź odbiorców, temat i wiadomość (maksymalnie 1000 znaków).",
  "text_4b42c6690ebe": "Administracja",
  "text_6d0ff17167bf": "Nie znaleziono wiadomości.",
  "text_753d6cdca15d": "Wybrany odbiorca nie jest już dostępny. Odśwież listę odbiorców.",
  "text_9e313cd30ea1": "Załącznik",
  "text_a8c327fb1b2a": "Nie znaleziono maszynisty",
  "text_aab4a4512402": "Brak uprawnień.",
  "text_ad0dcaacfb85": "Temat i wiadomość nie mogą być puste.",
  "text_bfaa2d8ffe47": "Nie znaleziono załącznika.",
  "text_fc4a9071ea60": "Załącznik nie może przekraczać 10 MB."
}
