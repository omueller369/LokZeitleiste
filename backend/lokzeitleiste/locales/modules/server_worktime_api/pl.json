{
  "text_0d912f29de32": "Ponowić można tylko nieudane powiadomienia",
  "text_0fe5137fab5c": "Wymagany powód zmiany",
  "text_21b97cd78bc2": "Nieprawidłowy okres: ",
  "text_67bd5cf60cd3": "Wpis został zmieniony. Wczytaj ponownie.",
  "text_804ae64b495f": "Nie znaleziono wpisu pracownika",
  "text_88c6c379cd6d": "Brak kraju związkowego pracownika",
  "text_907f24b01340": "Wysyłka e-mail nie jest skonfigurowana na serwerze",
  "text_9111bc2d71b6": "Wysyłka e-mail nie jest skonfigurowana",
  "text_942eccef0aae": "\nData zakończenia: ",
  "text_9f17ab58762b": "Nie znaleziono zmiany",
  "text_a18a6b0c6dcd": "Brak adresu e-mail pracownika",
  "text_bfddea399370": "Korygować można tylko zapisany czas",
  "text_d425970b74c9": "Nie znaleziono pracownika"
}
