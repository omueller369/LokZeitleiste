{
  "text_02053ab94a24": "Wybieranie długie",
  "text_09c15ad08a91": "Usunąć przesyłkę ze skrzynki? Zaimportowane wpisy pozostaną zachowane.",
  "text_19c002fd601a": "Odstawianie lokomotywy",
  "text_2b985e7c9f69": "Import zakończony.",
  "text_4d48da0a8b67": "Żądanie nieudane",
  "text_529ac693a9e9": "Telefon stacjonarny",
  "text_538eb08f1367": "Pominięte",
  "text_5706e2d8857e": "Nowy wpis stacji",
  "text_575e9d10ccd7": "Bez zmian",
  "text_6685bd272930": "Usuń przesyłkę",
  "text_705a70edfc63": "Zabezpieczanie pociągów",
  "text_7d806fa28930": "Inne uwagi szczególne",
  "text_833cce4e3125": "Telefon komórkowy",
  "text_8e31363947a6": "Zobacz",
  "text_96e4880b7570": "Stacje wysłano do skrzynki odbiorczej maszynisty.",
  "text_99c07a8b0e30": "Radio lokalne/wybieranie skrócone",
  "text_a0fe624208e6": "Uzupełnione",
  "text_a1f14b321431": "Numer Bada",
  "text_a3517a777958": "Cel na mojej liście stacji",
  "text_b3a38003992c": "Najpierw zapisz lub anuluj edycję.",
  "text_cc9b1a6c1e7a": "Pokaż numery telefonów",
  "text_ccccec0e691a": "Wybierz co najmniej jedną stację.",
  "text_ce535ae2e626": "Maksymalnie 50 stacji na udostępnienie.",
  "text_d9b1e13f3b97": "Nowe",
  "text_e038a68189a5": "Wybierz maszynistę."
}
