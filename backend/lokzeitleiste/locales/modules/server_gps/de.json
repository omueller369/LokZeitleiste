{
  "text_07743b7daef0": "Manuelle Standzeiten dürfen sich nicht überschneiden.",
  "text_094ba7dcb28a": "GPS-Zeitstempel müssen aufsteigen.",
  "text_0fd998791d67": "Halt",
  "text_146835ea0bc8": "Response too large",
  "text_27e6f9d32657": "Ungültiger Grund.",
  "text_31cbf51014e1": "Ungültige GPS-Auswahl.",
  "text_3299be54a680": "Incomplete OSM response",
  "text_348b25b6d7f6": "ZMS-Abfragen bitte mit Abstand wiederholen.",
  "text_58f91be54d8a": "Sonstigen Grund bitte angeben.",
  "text_5b9f556e58d7": "Bitte gültigen Endbahnhof wählen.",
  "text_69384a6be550": "sonstiges",
  "text_6d8354985870": "Ende muss nach Beginn der Standzeit liegen.",
  "text_7098ded12868": "GPS-Aufzeichnung höchstens 48 Stunden.",
  "text_90f858e75790": ")[\"place\"~\"^(city|town|village|hamlet|suburb|quarter|neighbourhood|locality|isolated_dwelling)$\"][\"name\"];out center tags;",
  "text_927e3ef652cc": "Nur eine Standzeit darf laufen.",
  "text_9ba3a6373f57": "ZMS-Dienst beschäftigt. Bitte später erneut versuchen.",
  "text_b418a717a2d3": "Bitte gültigen DS100-Standort wählen.",
  "text_be7663d51aa2": "Ungültiger älterer Ortsname.",
  "text_c3d8d43508a9": "ZMS-Daten derzeit nicht verfügbar. GPS bleibt gespeichert.",
  "text_c5c16d0e1424": "Bitte gültige DS100-Betriebsstellen wählen.",
  "text_caf70142ca12": "Standzeitkennung passt nicht zum Beginn.",
  "text_d425fe5589f1": "Keine GPS-Aufzeichnung vorhanden.",
  "text_da0bf51ad2de": "GPS-Punkte oder manuelle Standzeit erforderlich.",
  "text_e9455228bddf": "GPS-Aufzeichnung wurde geändert. Bitte neu laden.",
  "text_edfb4f6ac516": "Standzeit gehört nicht zur Aufzeichnung.",
  "text_f899e27a7248": "Standzeitkennungen müssen eindeutig sein.",
  "text_f96e8bf660b7": "Bitte einen gültigen Startbahnhof (DS100) wählen."
}
