{
  "text_0253738f9762": "Nie znaleziono firmy leasingowej.",
  "text_75edfe7e2c7c": "Pojazd został zmieniony. Wczytaj ponownie.",
  "text_81e8f7b73460": "Numer pojazdu już istnieje.",
  "text_a30e1969d617": "Gotowy do eksploatacji",
  "text_a7767461460f": "Gotowy z ograniczeniami",
  "text_d0713be2fe85": "Nie znaleziono pojazdu trakcyjnego.",
  "text_ec514a9cce8d": "Numer pojazdu musi zawierać 12 cyfr w formacie 00 00 0000 000-0.",
  "text_ee0a4ee77389": "Niegotowy do eksploatacji",
  "text_f9403d288c3a": "Wymagany jest powód lub ograniczenie."
}
