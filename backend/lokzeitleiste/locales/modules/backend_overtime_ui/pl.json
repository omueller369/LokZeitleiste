{
  "text_0d8ab260b84d": "Zmiany służbowe",
  "text_0d95fd6a769f": "Początek",
  "text_20fdd14890dd": "Konto nadgodzin nieaktywne",
  "text_24a29f44a444": "Nadgodziny w miesiącu",
  "text_2933070469a2": "Miesiąc",
  "text_2ddcd606c872": "Koniec",
  "text_2ee74e5f154f": "Konto nadgodzin",
  "text_32666af335b9": "Nadgodziny",
  "text_38ee859a969e": "Zakończone",
  "text_45989de49fb7": "Szczegóły",
  "text_47bed3954eac": "Na konto roczne, reszta do wypłaty",
  "text_4d48da0a8b67": "Żądanie nieudane",
  "text_6385c5d64871": "Roczne konto nadgodzin",
  "text_64509e1af49c": "Otwarte",
  "text_677e35634d12": "Otwórz ponownie rozliczenie",
  "text_6f53b45a1f72": "Aktywuj konto od wybranego miesiąca",
  "text_6fa18a3a64ca": "Zamknięcie miesiąca",
  "text_75df3579c730": "Rodzaj",
  "text_760cc329134a": "Do wypłaty",
  "text_80033f8258eb": "Użytkownik",
  "text_8163454f378f": "Aktywny",
  "text_87683817da28": "Przegląd roczny",
  "text_8c01ed2e16ed": "Miesiąc można zamknąć dopiero po jego zakończeniu.",
  "text_90ba1acfb80b": "Aktywacja",
  "text_9135882d323c": "Data",
  "text_920e413c7d41": "Status",
  "text_96bf0098166f": "Odśwież",
  "text_a03c8b99bc49": "Liczy się tylko czas ponad osiem godzin na zmianę. Przerw nie odlicza się; dojazdy poza służbą nie są uwzględniane. Przypisanie według rozpoczęcia służby.",
  "text_a1ca13575987": "Sprawdź",
  "text_a4ad259e71cb": "Akcja",
  "text_a644124f71e6": "Zamknij miesiąc",
  "text_b34c2046a396": "Oznacz do wypłaty",
  "text_b574d367e922": "Czas pracy",
  "text_b808f6e97075": "Zamknij",
  "text_bf7c9171cb49": "Nieaktywny",
  "text_c0e250d7048f": "Czas służby zmieniono po zamknięciu. Sprawdź i otwórz rozliczenie przed ponownym księgowaniem.",
  "text_d42c19a3cfd9": "Saldo pozostaje po zmianie roku. Limit 40 godzin dotyczy całego salda konta.",
  "text_de92d152d782": " UTC",
  "text_e45729eef52b": "Księgowanie zostanie cofnięte. Zrealizowane wypłaty wymagają osobnej korekty.",
  "text_e6c743f19ab8": "Powód ponownego otwarcia",
  "text_e7efc317ad09": "Zapisz aktywację",
  "text_ea83fc68f934": "Ponowne otwarcie",
  "text_f0cd91bc08fe": "Konto nadgodzin aktywne",
  "text_f21484df2cb9": "Na konto roczne",
  "text_f8720778ac3c": "Historia zmian",
  "text_fe2896e58446": "Rozdysponowanie przy zamknięciu miesiąca"
}
