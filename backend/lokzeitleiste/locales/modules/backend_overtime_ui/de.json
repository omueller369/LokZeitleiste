{
  "text_0d8ab260b84d": "Dienstschichten",
  "text_0d95fd6a769f": "Beginn",
  "text_20fdd14890dd": "Überstundenkonto inaktiv",
  "text_24a29f44a444": "Überstunden im Monat",
  "text_2933070469a2": "Monat",
  "text_2ddcd606c872": "Ende",
  "text_2ee74e5f154f": "Überstundenkonto",
  "text_32666af335b9": "Überstunden",
  "text_38ee859a969e": "Abgeschlossen",
  "text_45989de49fb7": "Details",
  "text_47bed3954eac": "Ins Jahreskonto, Rest zur Auszahlung",
  "text_4d48da0a8b67": "Anfrage fehlgeschlagen",
  "text_6385c5d64871": "Jahresüberstundenkonto",
  "text_64509e1af49c": "Offen",
  "text_677e35634d12": "Abschluss wieder öffnen",
  "text_6f53b45a1f72": "Konto ab ausgewähltem Monat aktivieren",
  "text_6fa18a3a64ca": "Monatsabschluss",
  "text_75df3579c730": "Art",
  "text_760cc329134a": "Auszahlung vorgemerkt",
  "text_80033f8258eb": "Benutzer",
  "text_8163454f378f": "Aktiv",
  "text_87683817da28": "Jahresübersicht",
  "text_8c01ed2e16ed": "Monatsabschluss erst nach Monatsende möglich.",
  "text_90ba1acfb80b": "Aktivierung",
  "text_9135882d323c": "Datum",
  "text_920e413c7d41": "Status",
  "text_96bf0098166f": "Aktualisieren",
  "text_a03c8b99bc49": "Je Dienstschicht zählt nur die Zeit über acht Stunden. Pausen werden nicht abgezogen; Gastfahrten außerhalb des Dienstes zählen nicht. Zuordnung nach Dienstbeginn.",
  "text_a1ca13575987": "Prüfen",
  "text_a4ad259e71cb": "Aktion",
  "text_a644124f71e6": "Monat abschließen",
  "text_b34c2046a396": "Zur Auszahlung vormerken",
  "text_b574d367e922": "Arbeitszeit",
  "text_b808f6e97075": "Schließen",
  "text_bf7c9171cb49": "Inaktiv",
  "text_c0e250d7048f": "Dienstzeiten nach Abschluss geändert. Abschluss prüfen und vor erneuter Buchung wieder öffnen.",
  "text_d42c19a3cfd9": "Guthaben bleibt beim Jahreswechsel erhalten. Die 40-Stunden-Grenze gilt für den gesamten Kontostand.",
  "text_de92d152d782": " UTC",
  "text_e45729eef52b": "Die Buchung wird zurückgenommen. Bereits erfolgte Auszahlungen müssen separat korrigiert werden.",
  "text_e6c743f19ab8": "Begründung für Wiederöffnung",
  "text_e7efc317ad09": "Aktivierung speichern",
  "text_ea83fc68f934": "Wiederöffnung",
  "text_f0cd91bc08fe": "Überstundenkonto aktiv",
  "text_f21484df2cb9": "Ins Jahreskonto",
  "text_f8720778ac3c": "Änderungsverlauf",
  "text_fe2896e58446": "Verwendung beim Monatsabschluss"
}
