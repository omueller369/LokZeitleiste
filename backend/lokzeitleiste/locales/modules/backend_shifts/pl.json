{
  "text_05d92e3d1d39": "Graniczna służba dzienna · 09:00–21:00 · 12 godz.",
  "text_05efdf1385f5": "Zachowaj",
  "text_064439d37dcf": "Poprzednio",
  "text_0feca887603d": "Do dnia włącznie",
  "text_2a03b719bef2": "Początek cyklu (pierwszy dzień pierwszego bloku)",
  "text_2a75a7cfb6c1": "Domyślnie: uzupełnij tylko nieplanowane dni. Święta zachowują normę 0 godzin. Okres i cykl mogą obejmować różne lata. Utworzone dni można dalej edytować w planowaniu personelu.",
  "text_2d23b0d21d95": "Ostatnie przypisania",
  "text_2ebfac5e73e6": " dni zachowano.",
  "text_2f28091327c1": "Maszynista graniczny",
  "text_2ffad239f778": "Nadpisz istniejący plan (w tym urlop)",
  "text_3678af8717e8": "Zastosuj do planu pracy",
  "text_3828375a2d45": "Usuń",
  "text_3d9277c50838": " dni zastosowano do planu pracy. ",
  "text_42827e0faba9": " dni do zastosowania · ",
  "text_429fbbd0a43e": "Modele zmian",
  "text_4a3c63177b10": "Nadpisać plan w tym okresie, w tym urlop?",
  "text_4a3e8852caf6": " dni do zachowania",
  "text_4da394b87b08": "Zmiana",
  "text_52b8ef8ce077": "Maszynista liniowy",
  "text_55a73a523124": "Graniczna służba nocna · 21:00–09:00 następnego dnia · 12 godz.",
  "text_562b7b6f4651": "Utwórz podgląd",
  "text_58657f87aa64": "Nowy model",
  "text_638f60cd4a7d": "Bloki powtarzają się w tej kolejności, np. 5 dni pracy i 2 wolne. Cykl ma do 366 dni. Zmiany modelu nie zmieniają automatycznie istniejących planów rocznych.",
  "text_640e86cbc244": "Od",
  "text_6a752e5af1a0": "Dodaj blok cyklu",
  "text_702b322d9171": "Cykl",
  "text_77d64b3ca8ca": "Służba liniowa",
  "text_7cf5a10071b5": "Maszynista",
  "text_83fff6a40be9": "Edytuj model",
  "text_84e45ee73411": "Edytuj",
  "text_8ff90a7889cc": " dni zmieniono",
  "text_9051780617fe": "Dodaj model zmian",
  "text_9135882d323c": "Data",
  "text_936378b371b9": "Zastosuj",
  "text_9a8f3c6555a9": "Model zmian zapisany.",
  "text_a4ad259e71cb": "Akcja",
  "text_a9f26acda28d": "Rodzaj dnia bloku cyklu",
  "text_ac970ead46e3": "Podgląd przypisania",
  "text_b111fdd03854": "Zastosowanie",
  "text_cf50f72af462": "Maszynista graniczny i trasowy",
  "text_cf6225ad3acf": "Liczba dni w bloku cyklu",
  "text_cffcbd9e175f": " do ",
  "text_d6467ada386f": "Przypisz model maszyniście",
  "text_dcae0a89d95b": "Zapisz model",
  "text_dcd1d5223f73": "Nazwa",
  "text_dedbf4528cee": "Model zmian",
  "text_e04d24c52b3d": "Strona główna",
  "text_e79aa42d7d18": "Dzień wolny",
  "text_eb8f579b6931": "Dzień pracy",
  "text_ecda07db6e0b": "Święto",
