{
  "text_01f0bddd4f9a": "Sprawca",
  "text_03879cd535ea": "Usunąć jazdę pociągiem i jej wpisy?",
  "text_06c3152a1577": "Usunąć wpis?",
  "text_078a815372af": "Do",
  "text_094196cbdf60": "Anuluj edycję",
  "text_09ebd5325efd": "Dodatkowa przerwa wymaga innego powodu i czasu co najmniej 15 minut.",
  "text_0df6ae9ee565": "Usuń rejestrację GPS przed usunięciem przejazdu.",
  "text_0df8087370c1": "Dodaj wpis",
  "text_0fd998791d67": "Postój",
  "text_1abed57a73e2": "DB InfraGo",
  "text_1bfd62f78608": "Stacja początkowa",
  "text_1e6760b90c10": "Choices unavailable",
  "text_1ec195f5b2d6": "Przygotowanie pociągu",
  "text_2087c99eb939": "CTL Logistics DE",
  "text_25d84ea63a88": "Przenieść postoje GPS do szczegółów jazdy?",
  "text_2888cb6eeb27": "Stacja pocz.",
  "text_2db812cfb16e": "Jazdy pociągiem",
  "text_2ddcd606c872": "Koniec",
  "text_2fd87f59c48a": "Stacja końcowa (DS100 lub nazwa)",
  "text_328bf4816a4e": "Przerwa CTL",
  "text_3a78695388b3": "Strona główna",
  "text_3dfbe9701ed4": "Numer pociągu: tylko litery i cyfry, maksymalnie dwanaście znaków.",
  "text_4112179c8995": "Wybierz",
  "text_42cb1ed44351": "Maksymalnie 50 jazd pociągiem na raport.",
  "text_43cda2210cac": "Odjazd",
  "text_4da2b1d2dc6f": "Jedna z przyczyn GPS nie jest już aktywna. Wybierz ją ponownie.",
  "text_4fc94f436c13": "Numer pociągu",
  "text_50298cc1480e": "Stacja końcowa",
  "text_52c5d4a0445b": "Jazda pociągiem",
  "text_54119d7a4d78": "Stacje",
  "text_5d7697a40f10": "Najpierw zapisz lub anuluj bieżący wpis przejazdu pociągu.",
  "text_5f35fa8f3600": "Udokumentowane przerwy nie mogą się nakładać.",
  "text_640e86cbc244": "Od",
  "text_64f45b98b2db": "Następstwo pociągów",
  "text_66775ecb98fd": "Usterka lokomotywy",
  "text_668cbe316167": "Czas trwania",
  "text_69384a6be550": "inne",
  "text_69cbb24c1115": "Najpierw dodaj zdarzenie lub anuluj edycję.",
  "text_706a152ebfca": "Usuń wpis",
  "text_712eb04a8318": "Dla każdego postoju wybierz i zapisz ZMS oraz przyczynę.",
  "text_7191a2755c05": "Koniec musi być późniejszy niż początek.",
  "text_747e6b75aeec": "Czas przerwy",
  "text_758f409ac4de": "Jazdy pociągiem i zdarzenia muszą mieścić się w służbie.",
  "text_75df3579c730": "Rodzaj",
  "text_76b0a5929c12": "Podmiot odpowiedzialny",
  "text_776ab3f6bcc7": "Usuń jazdę pociągiem",
  "text_77b565ab8918": "Dodaj także jako przerwę",
  "text_78608b8e11a3": "Wybierz powód i rodzaj.",
  "text_79f0e7ad7bbb": "Opisz inny rodzaj.",
  "text_7fe3366aac3e": "Podmiot trzeci",
  "text_858e4ba7a29f": "Przerwa",
  "text_979811cf207a": "Oczekiwanie na rozkład jazdy",
  "text_9bc60ffe0d9c": "Stacja początkowa (DS100 lub nazwa)",
  "text_9da7c77d68bf": "Dane pociągu",
  "text_a68a4fbcce44": "Opisz inny powód.",
  "text_a91f1ebf023d": "Stacja końc.",
  "text_af013449459d": "Rodzaj CTL musi być aktywny, aby przejąć dane GPS.",
  "text_af393c317172": "Miejsce (DS100 lub nazwa stacji)",
  "text_b3fb9769b581": "Brak nowych postojów GPS do przejęcia.",
  "text_b45f40c737c3": "Powód",
  "text_b956103acb08": "Maksymalnie 500 zdarzeń na jazdę pociągiem.",
  "text_bb7b03aebf87": "Wypełnij wszystkie dane przejazdu.",
  "text_cde67dfbede8": "Oczekiwanie na pociąg",
  "text_e4bb9f1ece9a": "Początek",
  "text_e5b961dc98e1": "Inny powód (maks. 256 znaków)",
  "text_e96c233d6638": "Stacja doc.",
  "text_ea479be144a5": "Nie można edytować tego raportu pracy.",
  "text_ec85a036c547": "Oczekiwanie na FPLO",
  "text_f079711187a4": "Przyjazd",
  "text_f2c98f9b3a93": "Nr pociągu",
  "text_f34068f22589": "Stacja pocz.",
  "text_f58f27a67f7d": "Przerwy z jazd pociągiem",
  "text_f6b2ff39f540": "Zapisz",
  "text_f833868f87d4": "Manewry",
  "text_f885ba1d1e84": "Inny rodzaj (maks. 50 znaków)",
  "text_fe08e27c0231": "Najpierw zakończ rejestrację GPS.",
  "text_fe918da42d20": "Punkt zgłoszenia/miejsce"
}
