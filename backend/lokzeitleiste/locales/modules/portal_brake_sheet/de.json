  "text_c28979148ea3": "Position im gesamten Wagenzug (1 = vorne)",
  "text_a2338b5fd37d": "Eigenes Bremsgewicht, t",
  "text_787cb40eca00": "Bremsstellung des geschleppten Tfz",
  "text_4e1a5113bb0d": "Bremsgewicht in G anrechnen?",
  "text_dd8dce06f5b0": "Bremsgewicht anrechnen",
  "text_4945884011af": "Mit 0 rechnen",
  "text_c153ddb9f279": "Zielbahnhof des geschleppten Tfz",
  "text_e1ab5ee69625": "Reihenfolge der Aussetzbahnhöfe (1, 2, …)",
  "text_f92f801d2555": "Länge des geschleppten Tfz, m",
  "text_a5e9792df119": "Gewicht des geschleppten Tfz, t",
  "text_aa34155bd848": "Bremszettel für die Fahrtabschnitte",
  "text_c751dda21c5e": "Ausgangsbremszettel bearbeiten",
  "text_a092f73716ce": "Automatischer Hinweis für Feld 9",
  "text_61dff2d93907": "Importiere zuerst die Wagenliste. Geschleppte Tfz werden zusätzlich als Wagen gezählt. Vergib eindeutige Positionen im gesamten Wagenzug. Gleiche Aussetzbahnhöfe brauchen dieselbe Reihenfolgenummer. Änderungen werden im Ausgangsbremszettel vorgenommen; Speichern erstellt die Abschnittsversionen neu.",
  "text_8849bbb7f2b4": "Neu berechnete Spaltensumme",
  "text_05a8b3df94c2": "Werte unverändert übernehmen – ohne Abzug",
  "text_1bfa94302ed8": "P-Summe [t]",
  "text_4367ed02a8c5": "G+P – G minus 25 %, über 500 m P minus 5 %",
  "text_59c1287f0b41": "Übernahme der G+P-Wagenliste",
  "text_6e7c13b082a4": "Bitte eine Übernahmeform wählen",
  "text_7450b3f6c81a": "Gesamtbremsgewicht vor Aufrundung [t]",
  "text_983d7a2c51e4": "Wagennummer",
  "text_984f0abcf321": "Alle Wagen in G (fehlendes G aus P kopieren)",
  "text_b74d1958a2e0": "Angerechnete G-Summe [t]",
  "text_c5b28e90d147": "G-Summe vor Abzug [t]",
  "text_d6e32f0a589b": "Wagenwerte nach gewählter Übernahme",
  "text_d82ab314590c": "Wähle die Berechnung vor der Übernahme. Bei „Alle Wagen in G“ wird ein fehlender G-Wert unverändert aus P kopiert. Bei „G+P“ wird die G-Summe um 25 % reduziert. Bei mehr als 500 m ungerundeter Wagenzuglänge wird zusätzlich die P-Summe um 5 % reduziert. „Unverändert“ übernimmt die vorhandenen Einzelwerte ohne weiteren Abzug. Prüfe die Werte und die Bremsstellung vor der Übernahme.",
  "text_c6a2b81d093e": "Angerechnete P-Summe [t]"
}
