{
  "text_137bdbfc3648": "Norma ",
  "text_1503916a2ab2": "Dzień",
  "text_153ed42fcd67": "Różnica",
  "text_16ab72874809": "Wt",
  "text_18cf679f8542": "Kalendarz roczny: przepracowane u góry, norma na dole. Kliknij dzień po szczegóły.",
  "text_1b162276df5d": " · Przepracowano ",
  "text_24a9b27f11fa": " dni niezaplanowanych · tymczasowa norma · saldo nieustalone",
  "text_273991ed5ada": "Przejazd pasażerski: ",
  "text_2933070469a2": "Miesiąc",
  "text_30094e0bec00": "Cz",
  "text_31146527558e": "Maszynista · Zestawienie godzin",
  "text_35d3a889824d": "Urlop",
  "text_388e10965041": "przepracowano ",
  "text_48ad904edbd6": "Zmiana: ",
  "text_4924410a9c62": "Do listy maszynistów",
  "text_49651ad689bd": "Różnica: przepracowano − norma",
  "text_4ab23b2761c1": ", norma ",
  "text_4d48da0a8b67": "Żądanie nieudane",
  "text_52aaba1b8dc5": "Rok ",
  "text_52e37a639da5": "Nie zaplanowano",
  "text_52f76d5f59f0": "Przepracowano",
  "text_57810709233e": "Status planu",
  "text_5b961de7cf4e": "Urlop: ",
  "text_601ffdc970c4": "Wczytaj przegląd",
  "text_63ae56b5ea30": "Wybierz dzień w wybranym roku.",
  "text_64509e1af49c": "Otwarte",
  "text_69f8618da479": "Święto + rodzaj dnia",
  "text_72e567e8962f": "Nie dodano jeszcze maszynistów.",
  "text_7cf5a10071b5": "Maszynista",
  "text_871dcbbcca6b": "Widok godzin",
  "text_879e9a63c9cc": "Notatka planu: ",
  "text_8c26e156b3fb": "Choroba: ",
  "text_917e2a1ea809": "Zarejestrowano: ",
  "text_9eae8e7efb47": "Kompletny",
  "text_a2791bb9b7dc": "Godziny zaliczone",
  "text_a592805ab955": "Odczyt wymaga planowania i czasu pracy lub raportów.",
  "text_a951efc79deb": "So",
  "text_adfdb6ab6693": "LokZeitleiste · Zestawienie godzin maszynistów",
  "text_b9c00671a51d": "Wybierz rok między 2000 a 2100.",
  "text_bdb4073dad92": " dni otwarte",
  "text_cd0a2b327cc5": "Święto w Berlinie",
  "text_d23e867e38e8": "Pn",
  "text_d39882af5190": "Czas przepracowany obejmuje przejazdy pasażerskie bez przerw. Zaliczone godziny obejmują też uzupełnienia, urlop i chorobę. Norma: praca/urlop 8 h, odpoczynek i święta Berlina 0 h. Przy otwartych dniach różnica nie jest ostatecznym saldem.",
  "text_d7eadc594242": "Planowana norma",
  "text_d8f33a13ae6e": "Śr",
  "text_e0737651718d": "Plan kompletny. Różnica dotyczy przepracowanych godzin; zaliczone godziny pokazano osobno.",
  "text_e6a284e4a729": "Wykonano ",
  "text_e79aa42d7d18": "Dzień wolny",
  "text_eb8f579b6931": "Dzień pracy",
  "text_ed1ad93b8967": "Rok",
  "text_eed8f901692d": "Pt",
  "text_efdb228c7d88": "Uzupełnienie: ",
  "text_f67b01013d57": " · święto w Berlinie",
  "text_fb1df1a24e3f": "Nd",
  "text_fd7058ac0c38": "Weekend"
}
