{
  "text_0b2cedf9699a": "Model został zmieniony. Wczytaj ponownie.",
  "text_1ef574f58e7c": "Okres musi być chronologiczny i obejmować najwyżej pięć lat.",
  "text_1f729bdb88a7": "Plan zmieniony. Wczytaj podgląd ponownie.",
  "text_20a5783654bf": "Nazwa wymagana; cykl do 366 dni.",
  "text_286d62fe23cf": "Model zmian: ",
  "text_52e37a639da5": "Nie zaplanowano",
  "text_544cd24912ce": "Model zmian zmieniony. Wczytaj ponownie.",
  "text_5acaadc6e827": "Plan zmieniono w międzyczasie",
  "text_5c3186377b14": "Nie znaleziono modelu zmian",
  "text_720039485f67": "Nie znaleziono modelu lub maszynisty",
  "text_96e398425db2": "Lata muszą mieścić się między 2000 a 2100.",
  "text_bce51f8460ec": "Nazwa modelu już istnieje",
  "text_e79aa42d7d18": "Dzień wolny",
  "text_eb8f579b6931": "Dzień pracy"
}
