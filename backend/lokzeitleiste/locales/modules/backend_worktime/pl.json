{
  "text_00d5d22d958b": "Wczytaj",
  "text_01a56c916c95": "Zapisz i powiadom",
  "text_042c3ad732f4": "Wpisz początek i koniec.",
  "text_045d9db46531": "Odrzucić niezapisane wpisy czasu?",
  "text_04ff2d0045ac": "Data zakończenia pracy ",
  "text_05dc77040983": "Zarejestrowano ręcznie",
  "text_078a815372af": "Do",
  "text_0af3584be783": "Noc",
  "text_0c4dfa06d8a5": "LokZeitleiste · Rejestracja i korekty czasu pracy",
  "text_0cbd67dd0c1f": " · Próby: ",
  "text_0d95fd6a769f": "Początek",
  "text_0f6dba7af022": "Początek pracy ",
  "text_130d0a280e7e": "Czerwiec",
  "text_13627ed53d53": "Powiadomienie ponownie w kolejce.",
  "text_161f3271aeb4": "Lipiec",
  "text_1b9031026550": "Brak zmian.",
  "text_1edbb8d0444f": "Administracja · ",
  "text_1f29b0671506": "Odblokowano",
  "text_21d68819f049": "Czas dzienny, tygodniowy i miesięczny zostanie przeliczony, a e-mail Przed → Po dodany do kolejki.",
  "text_23bbe45e70f5": "Historia zmian i wysyłka e-mail",
  "text_287167792b16": "Do administracji",
  "text_2933070469a2": "Miesiąc",
  "text_2ddcd606c872": "Koniec",
  "text_2e75737a6b58": " min",
  "text_366b32fafc58": "Dzienny czas pracy",
  "text_3e1e53e8a99d": "Wybierz pracownika i prawidłowy rok.",
  "text_3ee581183dbf": "Administrator #",
  "text_45f96e916050": "Zablokowano",
  "text_4afe6ea150d5": "Kwiecień",
  "text_4bd7dd175722": "Grudzień",
  "text_4cd0daded920": "Uzupełnienie",
  "text_4e1056bfe86b": "Październik",
  "text_4f10719c3f49": "; data zakończenia ",
  "text_50ed21787a1d": "Czas pracy to przepracowany czas bez przerw, z przejazdami pasażerskimi. Godziny zaliczone obejmują uzupełnienie do ośmiu godzin i urlop/chorobę. Tydzień trwa od poniedziałku do niedzieli, także poza wybranym miesiącem.",
  "text_52c5d4a0445b": "Jazda pociągiem",
  "text_560185323bd6": "E-mail: ",
  "text_574b19674395": "Koniec pracy ",
  "text_58e723bf4b22": "Najpierw utwórz pracownika.",
  "text_5953820b78b0": " · Konto #",
  "text_640e86cbc244": "Od",
  "text_6464de110988": "Wczytano czasy pracy.",
  "text_6d076e092638": "Miesięczny czas pracy",
  "text_72c89f093f77": "Zmieniono ręcznie",
  "text_72e3f979cbb6": "Edytuj jeden wpis: popraw początek i koniec, potem sprawdź. Stare i nowe godziny pojawią się przed zapisem. Koniec nie może poprzedzać początku. Dla zmiany nocnej wybierz następny dzień. Przerwa i przejazd pozostają bez zmian. Urlop i choroba nadal liczą osiem godzin.",
  "text_741e3c6e3464": "Skoryguj czas pracy",
  "text_742d257d7283": "Luty",
  "text_75df3579c730": "Rodzaj",
  "text_7bf28a5ed789": " · Wpis #",
  "text_7c4d852aa578": "Przejazd pasażerski",
  "text_7ce8cb2b56d6": "Tygodniowy czas pracy",
  "text_823becc01b72": "Norma planu z urlopem",
  "text_8446867dbbc4": "Powód: ",
  "text_858e4ba7a29f": "Przerwa",
  "text_86ac4d676251": "Marzec",
  "text_86c20d4afac8": "Wprowadź czas ręcznie",
  "text_8bb6ad99cbeb": " · Zablokowano",
  "text_8f7ca8e1dda1": "Nie przesłano jeszcze wpisów za ten miesiąc.",
  "text_9135882d323c": "Data",
  "text_926e66e23dec": "Żądanie nie powiodło się (",
  "text_935382ae5851": "Wymagane logowanie administratora",
  "text_94d9b2aae457": "Zapisz zmianę",
  "text_9643088e978b": "Pracownik administracji: brak planu czasu pracy maszynisty.",
  "text_9c779a6d5a2e": "Data końcowa: ",
  "text_9de6fe1d7265": "Listopad",
  "text_9f526c5eed70": "Czas zapisany i przeliczony. E-mail w kolejce; status wysyłki w historii.",
  "text_a1ca13575987": "Sprawdź",
  "text_a2791bb9b7dc": "Godziny zaliczone",
  "text_a4ad259e71cb": "Akcja",
  "text_a51e171b526f": "Edytuj zarejestrowany czas pracy",
  "text_a5984592501e": "Niedziela",
  "text_a66d8970e569": "Sierpień",
  "text_a82151bdb761": "Brak korekty czasu",
  "text_a88b0d6dfef3": "Dyżur",
  "text_abc2fce2c015": "Zapis przelicza czas dzienny, tygodniowy i miesięczny. Korekty administracyjne maszynisty tworzą też e-mail „Przed → Po”.",
  "text_adc1b8f3c384": "według dotychczasowej reguły północy",
  "text_aec9ebd295bb": "Tydzień kalendarzowy",
  "text_b574d367e922": "Czas pracy",
  "text_c3fa0e63c306": "Saldo: ",
  "text_c53af66563cf": "Wyślij e-mail ponownie",
  "text_c8f17701049e": "Odśwież status wysyłki",
  "text_c9f223d18f12": "Czas dzienny, tygodniowy i miesięczny zostanie przeliczony.",
  "text_cd559ea0abca": "Wrzesień",
  "text_ce6b745aedde": " dni niezaplanowanych; saldo jest obliczane dopiero po uzupełnieniu całego planu.",
  "text_d0e0faaee11b": " · Początek ",
  "text_d682e69d99c2": "Czas pracy zapisany i przeliczony.",
  "text_d77b6bd0886e": "Maj",
  "text_dcf11d0f1bca": "Godziny bez zmian.",
  "text_dd4fd942cb88": "Ewidencja czasu i korekty",
  "text_de92d152d782": " UTC",
  "text_e3068228eaf6": "Brak uprawnień do czasu pracy.",
  "text_e3e144a75b27": "Styczeń",
  "text_e4e8e850d125": "; koniec ",
  "text_e650a8f75edf": "nieudane",
  "text_ebd9aa50c1bd": "Data końcowa",
  "text_ecda07db6e0b": "Święto",
  "text_ed1ad93b8967": "Rok",
  "text_f048d324e017": "Powód zmiany",
  "text_f31b8681bfca": "Inny wpis czasu",
  "text_f4cb6891b9e5": "Pracownik",
  "text_f7ff1178af20": "Anuluj",
  "text_fa3f3eb687ec": "Miesięczne zaliczenie"
