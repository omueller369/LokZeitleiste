{
  "text_03c75e2c4ace": "Kein abgeschlossener Monat vorhanden.",
  "text_0595ec3c6b47": "Überstundenkonto ist für diesen Monat nicht aktiviert.",
  "text_0fe5137fab5c": "Änderungsgrund erforderlich",
  "text_2472b835f6c0": "Ungültige Dienstzeit im Überstundenkonto.",
  "text_4c8ec385d577": "Überstundenkonto wurde geändert. Bitte neu laden.",
  "text_4f22aac12893": "Zuerst betroffene Monatsabschlüsse wieder öffnen.",
  "text_52c5d4a0445b": "Zugfahrt",
  "text_75be4489f84a": "Monat ist bereits abgeschlossen.",
  "text_8c01ed2e16ed": "Monatsabschluss erst nach Monatsende möglich.",
  "text_9fc48529d452": "Ungültiger Kontostand im Überstundenkonto.",
  "text_bf05717abd04": "Geänderte Monatsabschlüsse zuerst prüfen und wieder öffnen.",
  "text_c6ef72ca00bb": "Ungültiger Monat",
  "text_d425970b74c9": "Mitarbeiter nicht gefunden",
  "text_f31b8681bfca": "Sonstige Erfassung"
}
