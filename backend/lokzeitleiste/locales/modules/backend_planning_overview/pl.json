{
  "text_04b9a3e19613": "Graniczna zmiana nocna",
  "text_0798ac12ba26": "Wczytywanie przeglądu…",
  "text_1aac7697634a": "Brak uprawnień do planowania.",
  "text_1e2ab7c4de47": "Sprawdź i potwierdź listę zmian.",
  "text_2933070469a2": "Miesiąc",
  "text_2c1743a9cbe8": "Łącznie maszynistów",
  "text_35d3a889824d": "Urlop",
  "text_3674b4bb4d92": "Maszyniści",
  "text_494b223e3b38": "Zaznacz wszystkie widoczne komórki",
  "text_4c2a3993c15d": "Automatycznie",
  "text_4da394b87b08": "Zmiana",
  "text_4e0059598284": "R = Dzień wolny",
  "text_52e37a639da5": "Nie zaplanowano",
  "text_54c8d377a08d": "Wybierz prawidłowy okres.",
  "text_65b13b015723": "Maksymalnie 10000 komórek na zmianę.",
  "text_6638bb26a46e": "Wymagane logowanie",
  "text_6c575da9d2b9": "Po przekątnej: święto + rodzaj dnia",
  "text_6c9b9f7f7346": "Graniczna zmiana dzienna",
  "text_73e424f56b16": "Brak maszynistów.",
  "text_74b487d9d223": "Notatka",
  "text_77d64b3ca8ca": "Służba liniowa",
  "text_7be33e84dc0b": "Kliknij lub dotknij komórek. Kliknięcie z Shift zaznacza prostokątny obszar obejmujący wielu maszynistów i dni.",
  "text_8074a948ba5d": "Odrzucić zaznaczenie?",
  "text_82eb6d4dc17a": "Święto w Berlinie · 0 godz.",
  "text_86830ef089fd": "? = Niezaplanowany",
  "text_89a0dbc0ea6f": "Zaznaczone komórki",
  "text_8a28e2902188": "Po",
  "text_8d19db2dc6b2": "Plan dni wolnych wszystkich maszynistów",
  "text_8d6ec9ab4dbd": "GN = Nocna służba graniczna",
  "text_8f1b85381d9a": "Brak zmian.",
  "text_9135882d323c": "Data",
  "text_926e66e23dec": "Żądanie nie powiodło się (",
  "text_96bf0098166f": "Odśwież",
  "text_9f1efe953941": "Zmiany planu zapisane.",
  "text_a4ce166e91ff": "Do zarządzania",
  "text_aacbdebb08dc": "Rodzaj dnia",
  "text_acd0d031a89c": "Potwierdź i zapisz",
  "text_b3579cf5f6d2": "Zastąp notatkę",
  "text_be9fba26f004": "A = Dzień pracy",
  "text_c1c14ac46946": "Rok: wszyscy maszyniści",
  "text_c8727e2064b7": "Przed",
  "text_c9d358c9156a": "LokZeitleiste · Plan dni wolnych wszystkich maszynistów",
  "text_d04102ec89b0": "Sprawdź zmiany przed zapisaniem",
  "text_d3ccaecf8e63": "GT = Dzienna służba graniczna",
  "text_d9e4ebbadf5f": "Miesiąc: wszyscy maszyniści",
  "text_dd71eeabda85": "Potwierdzam wymienione zmiany.",
  "text_e79aa42d7d18": "Dzień wolny",
  "text_eb8f579b6931": "Dzień pracy",
  "text_ed1ad93b8967": "Rok",
  "text_f1d43acd6460": "Zmiana zbiorcza",
  "text_f301512f9608": "U = Urlop",
  "text_f4d1e48c718f": "Usuń zaznaczenie",
  "text_f539371f8846": "Sprawdź zmiany",
  "text_f7ff1178af20": "Anuluj",
  "text_fd7058ac0c38": "Weekend"
}
