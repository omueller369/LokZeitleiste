{
  "text_06f32aa8b021": "Odblokuj",
  "text_0d95fd6a769f": "Początek",
  "text_15b63b4de303": "Potwierdź",
  "text_2ddcd606c872": "Koniec",
  "text_35d3a889824d": "Urlop",
  "text_4c15b048ecdf": "Wpisz czas pracy ręcznie",
  "text_509b3c4e5dad": "Hotel",
  "text_52c5d4a0445b": "Jazda pociągiem",
  "text_6e04951533a4": "Data końca początkowo odpowiada dacie początku. Przy służbie przez północ wybierz późniejszą datę końca. Gotowość nie zawiera przerwy, przejazdu pasażerskiego ani notatki. Urlop i choroba zachowują zasadę ośmiu godzin.",
  "text_6e487c4acefc": "Nie udało się zapisać wpisu (",
  "text_70d220ac37de": "Nazwa hotelu",
  "text_74b487d9d223": "Notatka",
  "text_75df3579c730": "Rodzaj",
  "text_7914de1da2fd": "Przejazd pasażerski (minuty)",
  "text_8a572015c49b": "Brak",
  "text_8a5c6ffd3497": "Uzasadnienie",
  "text_8cbbf452194f": "Wpis zapisany. Czas dzienny, tygodniowy i miesięczny zaktualizowany.",
  "text_8e778d2d4d09": "Zapisz wpis",
  "text_98a9c4972272": "Odwołana zmiana",
  "text_a8060ba6ff68": "Zapisywanie …",
  "text_a88b0d6dfef3": "Dyżur",
  "text_b55c50b88343": "Nocleg",
  "text_be1600b499c6": "Choroba",
  "text_bfe022ddd1f8": "Dyżur pod telefonem",
  "text_cc9d4f6c0040": "Nie można zmienić blokady.",
  "text_d2b058257743": "Przerwa (minuty)",
  "text_de166bc8de22": "Data zakończenia pracy",
  "text_dfaf5528f55b": "Data rozpoczęcia pracy",
  "text_ede90d358238": "Zablokuj wpis",
  "text_f31b8681bfca": "Inny wpis czasu",
  "text_f4eb30fc0356": "Gotowość poza domem",
  "text_f7ff1178af20": "Anuluj",
  "text_fad076d8684c": "Mieszkanie służbowe"
}
