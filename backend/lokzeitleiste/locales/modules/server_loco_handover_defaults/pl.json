{
  "text_1e1992d51ed6": "Tylko miejsca uszkodzenia można przypisać do kategorii.",
  "text_25b9ad8f3ac8": "Nazwa jest wymagana.",
  "text_49d3623ea7be": "Ta nazwa już istnieje.",
  "text_4a07125bae6a": "Wprowadź poprawny adres e-mail.",
  "text_5c5fa14fef76": "Nie znaleziono wartości.",
  "text_60fe685fe99d": "Wartość została zmieniona. Wczytaj ponownie.",
  "text_dd2687e1946c": "Najpierw wybierz istniejącą kategorię.",
  "text_e3e44fcea14c": "Adres e-mail jest wymagany.",
  "text_f51e128a924b": "Kategoria może zawierać maksymalnie 100 znaków."
}
